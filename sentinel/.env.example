# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-service.onrender.com/telegram/webhook/sentinel_secret_token
TELEGRAM_WEBHOOK_SECRET=sentinel_secret_token
ALLOWED_TELEGRAM_USER_IDS=[123456789]

# Database Configuration (Default SQLite for zero-config local testing, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///sentinel.db

# Hard $0 Budget Controls
DAILY_AI_BUDGET=0.0
ALLOW_PAID_PROVIDERS=false

# Free Tier AI Provider Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Ingestion Settings
INGEST_POLL_INTERVAL_HOURS=4
DIGEST_DELIVERY_TIME_IST=08:00
